<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- ホーム画面に出す入口は下の activity-alias 側に持たせる。
                 アイコンを差し替えるには、有効な alias を切り替えるしかない。
                 MainActivity 自体は常に有効にしておく（ディープリンク・共有
                 シート・ウィジェットの遷移先がここを指しているため）。 -->

            <!-- ホーム画面のショートカット（アイコン長押し）から入ってくる -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="myforward" />
            </intent-filter>

            <!-- 他アプリの共有シートに出す。文面は SharedTextPlugin が拾う -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <!--
            アイコンの色違い。ホーム画面に出るのはこのうち有効な 1 つだけで、
            切り替えは IconPlugin が setComponentEnabledSetting で行う。

            「今どのアイコンか」の出どころは、この有効・無効の状態そのもの
            （端末が覚えている）。アプリ側で別に控えると二重管理になる。

            ショートカットの meta-data は「ホーム画面に出る入口」に付ける
            決まりなので、各 alias に持たせる。
        -->
        <activity-alias
            android:name=".IconDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".IconMidnight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_midnight"
            android:roundIcon="@mipmap/ic_launcher_midnight_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".IconIndigo"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_indigo"
            android:roundIcon="@mipmap/ic_launcher_indigo_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".IconWine"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_wine"
            android:roundIcon="@mipmap/ic_launcher_wine_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <!--
            通知取得サービス。
            android:permission で「システムだけがバインドできる」ようにした上で、
            exported="true" にする必要がある。システムは別プロセスから
            バインドしに来るため、false だと繋がらない。
        -->
        <service
            android:name=".NotificationCaptureService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            ホーム画面ウィジェット（今週の生活費）。
            数字は WidgetBridgePlugin が SharedPreferences に書き、
            LivingWidgetProvider がそれを貼る。
        -->
        <receiver
            android:name=".LivingWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_living_info" />
        </receiver>

        <!-- 今月の支出（請求月の変動費 + 着地見込み） -->
        <receiver
            android:name=".SpendWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spend_info" />
        </receiver>

        <!-- 未確定の支出（通知から取り込んだ下書きの件数） -->
        <receiver
            android:name=".InboxWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_inbox_info" />
        </receiver>

        <!-- 支出を追加（押すだけ。数字を持たない） -->
        <receiver
            android:name=".AddWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_add_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        更新の取得。ストア配布ではないので、新しい APK を自分で受け取って
        インストーラに渡す。実際にインストールするか決めるのはユーザー。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
